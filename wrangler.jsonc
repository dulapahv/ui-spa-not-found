{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui-spa-not-found",
  "main": "worker.js",
  "compatibility_date": "2026-06-04",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "dulapahv.dev/not-found",
      "zone_name": "dulapahv.dev"
    },
    {
      "pattern": "dulapahv.dev/not-found/*",
      "zone_name": "dulapahv.dev"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
